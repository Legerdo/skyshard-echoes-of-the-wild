{
  "name": "skyshard-echoes-of-the-wild",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Skyshard: Echoes of the Wild - a browser 3D open-world action RPG",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --port 4173",
    "e2e": "node tools/play.mjs http://localhost:4173/",
    "ui-check": "node tools/ui-check.mjs http://localhost:4173/"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/three": "0.186.0",
    "puppeteer-core": "25.12.0",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
